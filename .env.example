# Copy to .env and fill in (never commit .env)
# Loaded automatically by argos.exe on startup (does not override existing env vars).

# Optional: UK HTTP(S) proxy if this egress receives HTTP 403 from Argos
# even with the Chrome-compatible request profile. Not required on many networks.
# Example shape (do not commit real credentials):
# HTTP_PROXY=http://USER:PASS@proxy.example.com:1337
# HTTPS_PROXY=http://USER:PASS@proxy.example.com:1337
HTTP_PROXY=
HTTPS_PROXY=

# Hyper Solutions — Akamai sensor / SEC-CPT adaptive challenge solving
HYPER_API_KEY=
